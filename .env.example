# ===========================================
# Backend — Gestión Tómbola (Standard 2026)
# Copiar a .env para local o cargar en Render/Railway
# ===========================================

NODE_ENV=development
PORT=4000

# MongoDB local o MongoDB Atlas (Staging / Producción)
MONGODB_URI=mongodb://localhost/tomboladb
# Ejemplo Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tomboladb?retryWrites=true&w=majority

# Secreto JWT (generar uno largo y aleatorio en producción: openssl rand -hex 32)
TOKEN_SECRET=cambiar_por_secreto_largo_y_seguro

# URL principal del frontend
FRONTEND_URL=http://localhost:5173

# Orígenes adicionales permitidos separados por coma (ej: dominio custom + staging)
ALLOWED_ORIGINS=
